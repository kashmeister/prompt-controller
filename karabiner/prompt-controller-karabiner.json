{
  "title": "prompt-controller (BT mini)",
  "rules": [
    {
      "description": "prompt-controller hold macros for a BT mini game controller (tap sends the normal key)",
      "manipulators": [
        {
          "type": "basic",
          "from": { "key_code": "escape", "modifiers": { "optional": ["any"] } },
          "to_if_alone": [{ "key_code": "escape" }],
          "to_if_held_down": [{ "key_code": "left_control", "modifiers": ["left_shift"] }],
          "conditions": [{ "type": "device_if", "identifiers": [{ "vendor_id": 17235, "product_id": 39689 }] }],
          "parameters": {
            "basic.to_if_alone_timeout_milliseconds": 500,
            "basic.to_if_held_down_threshold_milliseconds": 500
          }
        },
        {
          "type": "basic",
          "from": { "key_code": "right_arrow", "modifiers": { "optional": ["any"] } },
          "to_if_alone": [{ "key_code": "right_arrow" }],
          "to_if_held_down": [{ "key_code": "2", "repeat": false }],
          "conditions": [{ "type": "device_if", "identifiers": [{ "vendor_id": 17235, "product_id": 39689 }] }],
          "parameters": {
            "basic.to_if_alone_timeout_milliseconds": 500,
            "basic.to_if_held_down_threshold_milliseconds": 500
          }
        },
        {
          "type": "basic",
          "from": { "key_code": "down_arrow", "modifiers": { "optional": ["any"] } },
          "to_if_alone": [{ "key_code": "down_arrow" }],
          "to_if_held_down": [{ "key_code": "m", "modifiers": ["left_command"], "repeat": false }],
          "conditions": [{ "type": "device_if", "identifiers": [{ "vendor_id": 17235, "product_id": 39689 }] }],
          "parameters": {
            "basic.to_if_alone_timeout_milliseconds": 500,
            "basic.to_if_held_down_threshold_milliseconds": 500
          }
        }
      ]
    }
  ]
}
